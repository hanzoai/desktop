{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2022",
    "module": "esnext",
    "lib": ["es2022", "dom", "WebWorker"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "paths": {
      "@hanzo/desktop-brand-config": ["./libs/brand-config/src/index.ts"],
      "@hanzo/desktop-logo": ["./libs/hanzo-logo/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
