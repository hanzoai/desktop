# Hanzo Root Environment Variables
# Copy to .env and populate from KMS: kms.hanzo.ai

# Get from KMS: kms.hanzo.ai/hanzo/root/postgres-password
POSTGRES_PASSWORD=<from-kms>
# Get from KMS: kms.hanzo.ai/hanzo/root/redis-password
REDIS_PASSWORD=<from-kms>
# Get from KMS: kms.hanzo.ai/hanzo/root/jwt-secret
JWT_SECRET=<from-kms>

# LLM Providers - Get from KMS
# Get from KMS: kms.hanzo.ai/hanzo/root/openai-api-key
OPENAI_API_KEY=<from-kms>
# Get from KMS: kms.hanzo.ai/hanzo/root/anthropic-api-key
ANTHROPIC_API_KEY=<from-kms>
