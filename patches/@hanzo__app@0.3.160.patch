+const LOCAL_TEXT_MAX = 1024 * 1024;
+const LOCAL_IMAGE_MAX = 10 * 1024 * 1024;
+/** How the window can read `file` with no session: 'image', 'text', or a sentence saying why not. */
+export function localRead(file) {
+    if (file.type.startsWith('image/') || (!file.type && LOCAL_IMAGE_NAME.test(file.name)))
