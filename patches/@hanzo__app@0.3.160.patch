+// Hanzo Desktop, signed out: what the window reads itself, and how much of it.
+// A picture goes with the turn as itself; a text file as its text; anything else
+// (a PDF, a video, an archive) is only readable through the workspace, so it says
+// so instead of reaching the model as garbage or freezing the window.
+const LOCAL_TEXT = /^(text\/|application\/(json|xml|javascript|x-yaml|yaml|x-sh|sql|toml)$)/;
+const LOCAL_TEXT_NAME = /\.(txt|md|markdown|csv|tsv|json|jsonl|xml|ya?ml|toml|ini|log|html?|css|js|jsx|ts|tsx|py|rb|go|rs|java|kt|swift|c|h|cpp|hpp|cs|php|sh|sql)$/i;
