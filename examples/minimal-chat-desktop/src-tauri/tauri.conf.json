{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hanzo Desktop Starter",
  "version": "0.1.0",
  "identifier": "org.example.hanzo-desktop-starter",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Hanzo Desktop Starter",
        "width": 1024,
        "height": 720,
        "minWidth": 640,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ]
  }
}
