{
  "name": "@hanzo/desktop-oss",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source Hanzo Desktop SDK, reusable React + Tauri components, Rust desktop crates, and starter examples",
  "packageManager": "pnpm@11.24.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @hanzo/desktop-example-minimal dev",
    "build": "pnpm --filter @hanzo/desktop-example-minimal build",
    "typecheck": "pnpm -r --filter './libs/*' --filter './examples/*' run typecheck",
    "test": "vitest run",
    "test:rust": "cargo test --workspace --locked",
    "test:all": "pnpm typecheck && pnpm test && pnpm build && cargo test --workspace --locked"
  },
  "dependencies": {
    "@tauri-apps/api": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@tauri-apps/cli": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
