{
  "identifier": "main",
  "description": "The main window: every plugin permission it uses and every command the app registers (build.rs refuses a command it does not grant).",
  "local": true,
  "remote": {
    "urls": [
      "http://localhost:3000/*",
      "http://127.0.0.1:3000/*",
      "http://localhost:1420/*",
      "http://127.0.0.1:1420/*",
      "https://hanzo.ai/*",
      "https://*.hanzo.ai/*",
      "https://hanzo.team/*",
      "https://*.hanzo.team/*",
      "https://hanzo.id/*",
      "https://*.hanzo.id/*"
    ]
  },
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "deep-link:default",
    "dialog:allow-save",
    "fs:allow-download-write",
    "shell:allow-open",
    "core:window:allow-start-dragging",
    "core:window:default",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-close",
    "updater:allow-check",
    "updater:allow-download",
    "updater:allow-install",
    "updater:allow-download-and-install",
    "process:allow-restart",
    "log:default",
    "dialog:allow-open",
    "os:allow-hostname",
    "notification:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "$HOME/Downloads/*"
        }
      ]
    },
    "opener:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://mcp.composio.dev"
        },
        {
          "url": "https://chatgpt.com/*"
        },
        {
          "url": "https://api.anthropic.com/*"
        },
        {
          "url": "https://claude.ai/*"
        },
        {
          "url": "https://api.hanzo.ai/*"
        },
        {
          "url": "https://hanzo.ai/*"
        },
        {
          "url": "https://hanzo.id/*"
        }
      ],
      "deny": []
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        { "path": "**" },
        { "path": "$HOME/**" }
      ]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [
        { "path": "**" },
        { "path": "$HOME/**" }
      ]
    },
    {
      "identifier": "fs:allow-read-file",
      "allow": [
        { "path": "**" },
        { "path": "$HOME/**" }
      ]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [
        { "path": "**" },
        { "path": "$HOME/**" }
      ]
    },
    {
      "identifier": "fs:allow-read-dir",
      "allow": [
        { "path": "**" },
        { "path": "$HOME/**" }
      ]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        { "path": "**" },
        { "path": "$HOME/**" }
      ]
    },
    {
      "identifier": "fs:allow-create",
      "allow": [
        { "path": "**" },
        { "path": "$HOME/**" }
      ]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [
        { "path": "**" },
        { "path": "$HOME/**" }
      ]
    },
    {
      "identifier": "fs:allow-rename",
      "allow": [
        { "path": "**" },
        { "path": "$HOME/**" }
      ]
    },
    {
      "identifier": "fs:allow-copy-file",
      "allow": [
        { "path": "**" },
        { "path": "$HOME/**" }
      ]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [
        { "path": "**" },
        { "path": "$HOME/**" }
      ]
    },
    {
      "identifier": "fs:allow-stat",
      "allow": [
        { "path": "**" },
        { "path": "$HOME/**" }
      ]
    },
    "allow-identity-adopt",
    "allow-identity-file",
    "allow-local-workspace-open-dialog",
    "allow-local-workspace-open-file-dialog",
    "allow-local-workspace-clone-repo",
    "allow-local-workspace-import-file",
    "allow-local-workspace-list",
    "allow-local-workspace-read-file",
    "allow-local-workspace-write-file",
