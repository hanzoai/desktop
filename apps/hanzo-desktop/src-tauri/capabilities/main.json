{
  "identifier": "main",
  "description": "The main window, its own pages only: every plugin permission it uses and every command the app registers (build.rs refuses a command it does not grant). No remote origin is listed, so a page from another origin, a hanzo.ai frame included, reaches nothing; the window never shows one itself (main.rs `away` sends every other origin to the system browser).",
  "local": true,
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "deep-link:default",
    "dialog:allow-save",
    "fs:allow-download-write",
    "shell:allow-open",
    "core:window:allow-start-dragging",
    "core:window:default",
    "core:window:allow-minimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-close",
    "updater:allow-check",
    "updater:allow-download",
    "updater:allow-install",
    "updater:allow-download-and-install",
    "process:allow-restart",
    "log:default",
    "dialog:allow-open",
    "os:allow-hostname",
    "notification:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "$HOME/Downloads/*"
        }
      ]
    },
    "opener:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://mcp.composio.dev"
        },
        {
          "url": "https://chatgpt.com/*"
        },
        {
          "url": "https://api.anthropic.com/*"
        },
        {
          "url": "https://claude.ai/*"
        },
        {
          "url": "https://api.hanzo.ai/*"
        },
        {
          "url": "https://hanzo.ai/*"
        },
        {
          "url": "https://hanzo.id/*"
        }
      ],
      "deny": []
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        { "path": "**" },
        { "path": "$HOME/**" }
      ]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [
        { "path": "**" },
        { "path": "$HOME/**" }
      ]
    },
    {
      "identifier": "fs:allow-read-file",
      "allow": [
        { "path": "**" },
        { "path": "$HOME/**" }
      ]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [
        { "path": "**" },
        { "path": "$HOME/**" }
      ]
    },
    {
      "identifier": "fs:allow-read-dir",
      "allow": [
        { "path": "**" },
        { "path": "$HOME/**" }
      ]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        { "path": "**" },
        { "path": "$HOME/**" }
      ]
    },
    {
      "identifier": "fs:allow-create",
      "allow": [
        { "path": "**" },
        { "path": "$HOME/**" }
      ]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [
        { "path": "**" },
        { "path": "$HOME/**" }
      ]
    },
    {
      "identifier": "fs:allow-rename",
      "allow": [
        { "path": "**" },
        { "path": "$HOME/**" }
      ]
    },
    {
      "identifier": "fs:allow-copy-file",
      "allow": [
        { "path": "**" },
        { "path": "$HOME/**" }
      ]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [
        { "path": "**" },
        { "path": "$HOME/**" }
      ]
    },
    {
      "identifier": "fs:allow-stat",
      "allow": [
        { "path": "**" },
        { "path": "$HOME/**" }
      ]
    },
    "allow-identity-adopt",
    "allow-identity-file",
    "allow-local-workspace-open-dialog",
    "allow-local-workspace-open-file-dialog",
    "allow-local-workspace-clone-repo",
    "allow-local-workspace-import-file",
    "allow-local-workspace-list",
    "allow-local-workspace-read-file",
    "allow-local-workspace-write-file",
    "allow-local-workspace-create-file",
    "allow-local-workspace-create-dir",
    "allow-local-workspace-delete",
    "allow-local-workspace-run-dev",
    "allow-local-workspace-discover",
    "allow-local-dev-setup-cancel",
    "allow-local-site-folder",
    "allow-local-site-capture",
    "allow-local-preview-start",
    "allow-local-preview-stop",
    "allow-local-preview-open",
    "allow-dev-local-pairing",
    "allow-dev-local-runtime",
    "allow-engines-discover",
    "allow-hardware-get-summary",
    "allow-iam-loopback",
    "allow-report-redact",
    "allow-local-models-status",
    "allow-local-models-pull",
    "allow-local-models-cancel",
    "allow-local-models-remove",
    "allow-local-models-serve",
    "allow-local-models-stop",
    "allow-mining-get-enabled",
    "allow-mining-set-enabled"
  ]
}
