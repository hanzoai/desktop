{
  "identifier": "spotlight",
  "description": "The spotlight window: the plugin calls and commands its own bundle makes, measured from the build, and nothing of the main window's.",
  "local": true,
  "windows": [
    "spotlight"
  ],
  "permissions": [
    "core:default",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:event:allow-emit",
    "core:window:allow-start-dragging",
    "dialog:allow-save",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "$HOME/Downloads/*"
        }
      ]
    },
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://mcp.composio.dev"
        },
        {
          "url": "https://chatgpt.com/*"
        },
        {
          "url": "https://api.anthropic.com/*"
        },
        {
          "url": "https://claude.ai/*"
        },
        {
          "url": "https://api.hanzo.ai/*"
        }
      ],
      "deny": []
    },
    "process:allow-restart",
    "log:default",
    "allow-download-logs",
    "allow-get-request",
    "allow-hanzo-node-get-default-model",
    "allow-hanzo-node-get-options",
    "allow-hanzo-node-is-running",
    "allow-hanzo-node-kill",
    "allow-hanzo-node-open-chat-folder",
    "allow-hanzo-node-open-storage-location-with-path",
    "allow-hanzo-node-remove-storage",
    "allow-hanzo-node-set-default-options",
    "allow-hanzo-node-set-options",
    "allow-hanzo-node-spawn",
    "allow-hide-spotlight-window-app",
    "allow-open-main-window-with-path-app",
    "allow-post-request",
    "allow-retrieve-logs",
    "allow-secure-storage-delete",
    "allow-secure-storage-get",
    "allow-secure-storage-set",
    "allow-show-hanzo-node-manager-window",
    "allow-show-spotlight-window-app"
  ]
}
