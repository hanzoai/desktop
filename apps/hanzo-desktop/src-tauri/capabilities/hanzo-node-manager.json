{
  "identifier": "hanzo-node-manager",
  "description": "permissions that were migrated from v1",
  "local": true,
  "windows": [
    "hanzo-node-manager"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "log:default",
    "dialog:allow-save",
    "fs:allow-download-write",
    "dialog:allow-open",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "$HOME/Downloads/*"
        }
      ]
    },
    "allow-download-logs",
    "allow-hanzo-node-get-default-model",
    "allow-hanzo-node-get-options",
    "allow-hanzo-node-is-running",
    "allow-hanzo-node-kill",
    "allow-hanzo-node-open-storage-location-with-path",
    "allow-hanzo-node-remove-storage",
    "allow-hanzo-node-set-default-options",
    "allow-hanzo-node-set-options",
    "allow-hanzo-node-spawn",
    "allow-model-tools-bitdelta-apply",
    "allow-model-tools-bitdelta-encode",
    "allow-model-tools-grpo-run",
    "allow-model-tools-soup-available",
    "allow-model-tools-soup-average",
    "allow-model-tools-soup-delta",
    "allow-retrieve-logs",
    "allow-secure-storage-delete",
    "allow-secure-storage-get",
    "allow-secure-storage-set",
    "allow-show-hanzo-node-manager-window"
  ]
}
