<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <!-- The release entitlements, and the only ones: every macOS bundle is signed with this file
       under the hardened runtime. Keep only what the app uses; scripts/check-macos-signing.py
       refuses anything else, get-task-allow first (Apple's notary service rejects it). -->
  <dict>
    <!-- Dictation and talk mode in the chat (@hanzo/voice getUserMedia({ audio })). The hardened
         runtime refuses the microphone without it. -->
    <key>com.apple.security.device.audio-input</key><true/>
  </dict>
</plist>
