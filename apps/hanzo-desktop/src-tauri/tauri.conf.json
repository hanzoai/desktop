{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:ci",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "bundle": {
    "active": true,
    "targets": ["app", "appimage", "deb", "rpm", "nsis", "msi", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["llm-models/"],
    "linux": {
      "rpm": {
        "compression": {
          "type": "none"
        }
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "createUpdaterArtifacts": true
  },
  "productName": "Hanzo",
  "mainBinaryName": "hanzo-desktop",
  "version": "../../../package.json",
  "identifier": "ai.hanzo.desktop",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcwNEY4MkEzRTk1Q0M5NkYKUldSdnlWenBvNEpQY0p1OGJBMUMrUXpJclVFc2EwMU50U3VUNFR2Um9wbjM2ejAyeCtZb3c5a3EK",
      "endpoints": [
        "https://github.com/hanzoai/desktop/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "basicUi"
      }
    },
    "deep-link": {
      "desktop": {
        "schemes": ["hanzo"]
      }
    }
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "dangerousDisableAssetCspModification": ["style-src"],
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://fonts.googleapis.com; img-src 'self' data: blob: https:; font-src 'self' data: https://cdn.jsdelivr.net https://fonts.gstatic.com; media-src 'self' data: blob: https:; worker-src 'self' blob:; frame-src 'self' blob: https: http://127.0.0.1:* http://localhost:*; connect-src 'self' ipc: http://ipc.localhost hanzo-studio: http://hanzo-studio.localhost https://hanzo-studio.localhost http://127.0.0.1:* http://localhost:* ws://127.0.0.1:* ws://localhost:* https: wss:; object-src 'none'; base-uri 'self'; form-action 'self'"
    },
    "windows": [
      {
        "label": "main",
        "transparent": true,
        "title": "Hanzo",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "dragDropEnabled": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "decorations": true,
        "shadow": true,
        "center": true,
        "create": false
      }
    ],
    "macOSPrivateApi": true
  }
}
