{
  "name": "hanzo-desktop",
  "private": true,
  "type": "module",
  "scripts": {
    "download-binaries": "cd src-tauri && ./download-binaries.sh",
    "dev": "pnpm run download-binaries && vite",
    "build": "pnpm run download-binaries && vite build",
    "build:ci": "vite build",
    "typecheck": "node ../../node_modules/typescript-7/bin/tsc --noEmit -p tsconfig.app.json",
    "preview": "vite preview",
    "lint": "eslint --ext .js,.jsx,.ts,.tsx .",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "build:hanzo": "node ./scripts/brand-build.cjs hanzo",
    "build:team": "node ./scripts/brand-build.cjs team",
    "build:zoo": "node ./scripts/brand-build.cjs zoo",
    "build:lux": "node ./scripts/brand-build.cjs lux",
    "e2e:build": "tauri build --debug",
    "test:e2e": "wdio run ./wdio.conf.ts",
    "test:smoke": "playwright test",
    "test:e2e:deep": "playwright test --config playwright.deep.config.ts",
    "film": "playwright test --project=film-landscape --project=film-portrait --output=e2e-tests/.film",
    "film:masters": "node e2e-tests/masters.mjs"
  }
}
